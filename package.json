{
  "name": "srxq-xiangqi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "象棋小游戏《逐鹿》：经典双人 + 三人逐鹿",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
